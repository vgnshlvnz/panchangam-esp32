# Contains no secrets. Wi-Fi and webhook are set via `idf.py menuconfig`
# (Panchangam Configuration); sdkconfig itself is gitignored.

# ESP32-S3 N16R8: 16MB quad flash, 8MB octal PSRAM
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# swisseph statics are large; keep them out of internal RAM
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# TLS to hooks.slack.com
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y

# X posting: empty placeholders. Set the real values with `idf.py menuconfig`
# (Panchangam Configuration); sdkconfig is gitignored.
CONFIG_X_OAUTH2_ACCESS_TOKEN=""
CONFIG_X_OAUTH2_CLIENT_ID=""
CONFIG_X_OAUTH2_CLIENT_SECRET=""
